          value: pad_for_alignment
    - id: 24
      stage: stacker
      node_type: MERGER
      display_name: Stacker
      user_label: Stack
      x: 725
      y: 50
      parameters:
        mode:
          type: string
          value: Weighted
        reject_sigma:
          type: double
          value: 5
        no_diff_dod:
          type: bool
          value: false
        passthrough:
          type: bool
          value: false
        sample_align:
          type: bool
          value: true
        audio_stacking:
