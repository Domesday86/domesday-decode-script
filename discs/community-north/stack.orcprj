          type: string
          value: 8
        ffv1_slices:
          type: string
          value: auto
        decoder_type:
          type: string
          value: multiple
        decoder_schedule:
          type: string
          value: transform2d, held:transform3d
        display_aspect_ratio:
          type: string
          value: 4:3
        noise_reduction:
