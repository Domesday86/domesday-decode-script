# ORC Project File
# Version: 2.0
#
# Community North, every set: each decode through a Disc Mapper frame map,
# then all of them into one Source Align, for the selection report (phase 4).
# Nothing is stacked or written; the project has no sink. build-pack.sh's map
# stage copies this beside its outputs, points each source at its set's
# decode with orc-cli nodes set, and runs orc-cli tools refresh, which maps
# every set and then aligns them.
#
# Each source is labelled with its set id, as in decode-community-north.sh's
# SETS table, and its frame map "<set> map". A set that cannot be mapped is
# dropped from the map stage by deleting its source and frame map here (DS7
# is, while ld-decode cannot finish its decode: decode-community-north.sh).
# The refresh tools are recorded under tool_refresh: field_mapping on every frame
# map (lead-in and lead-out kept), source_alignment on Align
# (pad_for_alignment).

project:
  name: Community North map
  version: 2.0
  video_format: PAL
  source_format: Composite
  amplitude_unit: 10bit
dag:
  nodes:
    - id: 1
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS1
      x: 50
      y: 50
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
