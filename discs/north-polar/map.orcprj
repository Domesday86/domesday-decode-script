# ORC Project File
# Version: 2.0
#
# North Polar, every set: each decode through a Disc Mapper
# frame map, then all of them into one Source Align, for the selection
# report (phase 4). Nothing is stacked or written; the project has no sink.
# build-pack.sh's map stage copies this beside its outputs, points each
# source at its set's decode with orc-cli nodes set, and runs orc-cli tools
# refresh, which maps every set and then aligns them.
#
# Each source is labelled with its set id, as in
# decode-north-polar.sh's SETS table, and its frame map "<set> map". A
# set that cannot be mapped is dropped from the map stage by deleting its
# source and frame map here. The refresh tools are recorded under
# tool_refresh: field_mapping on every frame map (lead-in and lead-out kept),
# source_alignment on Align (pad_for_alignment),
# and fm_beat_calibration on each "<set> beat".
#
# Each "<set> beat" is an FM Beat Cancel on a branch off its frame map,
# feeding nothing: the refresh's FM Beat Calibration measures the master's
# carrier on it (300 frames, about 30 s a set), and the map stage commits the
# value as framemaps/<set>.carrier, for the stack's FM Beat Cancel on that set
# (decode-orc#354). The captures of one master measure within 1-3 kHz of each
# other.

project:
  name: North Polar map
  version: 2.0
  video_format: PAL
  source_format: Composite
  amplitude_unit: 10bit
dag:
  nodes:
    - id: 1
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS1
      x: 50
      y: 50
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 2
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS2
      x: 50
      y: 175
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 3
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS1 map
      x: 275
      y: 50
      tool_refresh:
        tool: field_mapping
      parameters:
        ranges:
          type: string
          value: ""
    - id: 4
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS2 map
      x: 275
      y: 175
      tool_refresh:
        tool: field_mapping
      parameters:
        ranges:
          type: string
          value: ""
    - id: 5
      stage: source_align
      node_type: COMPLEX
      display_name: Source Align
      user_label: Align
      x: 500
      y: 50
      tool_refresh:
        tool: source_alignment
      parameters:
        alignmentMap:
          type: string
          value: ""
        alignmentMode:
          type: string
          value: pad_for_alignment
    - id: 6
      stage: fm_beat_cancel
      node_type: TRANSFORM
      display_name: FM Beat Cancel
      user_label: DS1 beat
      x: 387
      y: 50
      tool_refresh:
        tool: fm_beat_calibration
      parameters:
        carrier_black_mhz:
          type: double
          value: 7.1
    - id: 7
      stage: fm_beat_cancel
      node_type: TRANSFORM
      display_name: FM Beat Cancel
      user_label: DS2 beat
      x: 387
      y: 175
      tool_refresh:
        tool: fm_beat_calibration
      parameters:
        carrier_black_mhz:
          type: double
          value: 7.1
  edges:
    - from: 1
      to: 3
    - from: 2
      to: 4
    - from: 3
      to: 5
    - from: 3
      to: 6
    - from: 4
      to: 5
    - from: 4
      to: 7
