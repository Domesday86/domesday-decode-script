# ORC Project File
# Version: 2.0
#
# City Culture 2, the video stack: the sets selection.yaml chooses for the video,
# in its order, each through a Frame Map and an FM Beat Cancel, all into one
# Source Align, then the Stacker, Dropout Correction, Picture Band Limit and
# the video sink that writes the pack's mkv. build-pack.sh's video stage
# copies this beside its outputs, points each source at its set's decode, sets
# each frame map and the alignment from the committed
# discs/city-culture2/framemaps/ (made by the map stage), and processes it.
# Nothing here is refreshed, so the stack is built from the reviewed maps.
#
# Each source is labelled with its set id and its frame map "<set> map", as in
# map.orcprj. The sources must be the video sets of selection.yaml, in the
# same order: the first sets the Stacker's sample grid (the compare report's
# suggested reference). Adding or dropping a set means editing this project.
#
# The chain follows decode-orc#354's advice, as on Community South:
#
# - "<set> beat", FM Beat Cancel, between each frame map and Align: before the
#   Stacker, since the beat's phase differs between masters. The video stage
#   sets each one's carrier_black_mhz from framemaps/<set>.carrier, which the
#   map stage measures.
# - The Stacker is Weighted, with sample_align and still_frame_stacking.
#   pressing_repair is off: Source Alignment finds one stamper group
#   (selection.yaml), so there is no other group to repair a stamper's defect
#   from.
# - No Audio Channel Map vbi_mono_average. audio_stacking stays Mean.
# - Dropout Correction fills dropouts by interpolate, from the clean lines
#   above and below, luma and chroma apart.
# - "Band", Picture Band Limit, after Dropout Correction: it low-passes the
#   luma where the picture ends, the map stage's lumaCutoffMHz
#   (framemaps/picture-band), measured between captures of different stamper
#   families. The video stage sets cutoff_mhz from it; rolloff_mhz stays 0.4.
#   Chroma is untouched.
#
# The Stacker stacks repeats (still_frame_stacking): a picture held over
# several frames is stacked across them as well as across the sets, which is
# most of what stacking gains on held pictures. still_frame_search,
# luma_level_match and chroma_gain_match are left to decode-orc's defaults (24
# frames, on, on). The video sink decodes every frame with transform2d: the
# disc is mostly stills (the phase 5 table in docs/emulator-pack-plan.md).
# build-pack.sh sets the decoder from disc.conf, so the two are the same.

project:
  name: City Culture 2 stack
  version: 2.0
  video_format: PAL
  source_format: Composite
  amplitude_unit: 10bit
dag:
  nodes:
    - id: 1
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS2
      x: 50
      y: 50
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 2
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS1
      x: 50
      y: 175
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 3
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS2 map
      x: 275
      y: 50
      parameters:
        ranges:
          type: string
          value: ""
    - id: 4
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS1 map
      x: 275
      y: 175
      parameters:
        ranges:
          type: string
          value: ""
    - id: 5
      stage: source_align
      node_type: COMPLEX
      display_name: Source Align
      user_label: Align
      x: 500
      y: 50
      parameters:
        alignmentMap:
          type: string
          value: ""
        alignmentMode:
          type: string
          value: pad_for_alignment
    - id: 6
      stage: stacker
      node_type: MERGER
      display_name: Stacker
      user_label: Stack
      x: 725
      y: 50
      parameters:
        mode:
          type: string
          value: Weighted
        reject_sigma:
          type: double
          value: 5
        no_diff_dod:
          type: bool
          value: false
        passthrough:
          type: bool
          value: false
        sample_align:
          type: bool
          value: true
        audio_stacking:
          type: string
          value: Mean
        efm_stacking:
          type: string
          value: Disabled
        still_frame_stacking:
          type: bool
          value: true
        pressing_repair:
          type: bool
          value: false
    - id: 7
      stage: dropout_correct
      node_type: TRANSFORM
      display_name: Dropout Correction
      user_label: DOC
      x: 950
      y: 50
      parameters:
        method:
          type: string
          value: interpolate
        overcorrect_extension:
          type: uint32
          value: 0
        match_chroma_phase:
          type: bool
          value: true
        highlight_corrections:
          type: bool
          value: false
    - id: 8
      stage: video_sink
      node_type: SINK
      display_name: Video Sink
      user_label: Video Out
      x: 1175
      y: 50
      parameters:
        output_path:
          type: string
          value: ""
        output_mode:
          type: string
          value: ffmpeg
        ffmpeg_format:
          type: string
          value: mkv-ffv1-bt601
        bt601_bit_depth:
          type: string
          value: 8
        ffv1_slices:
          type: string
          value: auto
        decoder_type:
          type: string
          value: transform2d
        decoder_schedule:
          type: string
          value: ""
        display_aspect_ratio:
          type: string
          value: 4:3
        noise_reduction:
          type: double
          value: 0
        chroma_gain:
          type: double
          value: 1
        chroma_phase:
          type: double
          value: 0
        embed_audio:
          type: bool
          value: true
        audio_channel_pairs:
          type: string
          value: all
        audio_gain_db:
          type: double
          value: 0
        embed_chapter_metadata:
          type: bool
          value: true
        embed_disc_metadata:
          type: bool
          value: true
        disc_metadata_detail:
          type: string
          value: map
        video_filter:
          type: string
          value: ""
    - id: 9
      stage: fm_beat_cancel
      node_type: TRANSFORM
      display_name: FM Beat Cancel
      user_label: DS2 beat
      x: 387
      y: 50
      parameters:
        carrier_black_mhz:
          type: double
          value: 7.1
    - id: 10
      stage: fm_beat_cancel
      node_type: TRANSFORM
      display_name: FM Beat Cancel
      user_label: DS1 beat
      x: 387
      y: 175
      parameters:
        carrier_black_mhz:
          type: double
          value: 7.1
    - id: 11
      stage: picture_band_limit
      node_type: TRANSFORM
      display_name: Picture Band Limit
      user_label: Band
      x: 950
      y: 150
      parameters:
        cutoff_mhz:
          type: double
          value: 5.4
        rolloff_mhz:
          type: double
          value: 0.4
  edges:
    - from: 1
      to: 3
    - from: 2
      to: 4
    - from: 3
      to: 9
    - from: 4
      to: 10
    - from: 5
      to: 6
    - from: 6
      to: 7
    - from: 7
      to: 11
    - from: 9
      to: 5
    - from: 10
      to: 5
    - from: 11
      to: 8
