# ORC Project File
# Version: 2.0
#
# EcoDisc Side 1, the video stack: the sets selection.yaml chooses for the
# video, in its order, each through a Frame Map, all into one Source Align,
# then the Stacker, Dropout Correction and the video sink that writes the
# pack's mkv. build-pack.sh's video stage copies this beside its outputs,
# points each source at its set's decode, sets each frame map and the
# alignment from the committed discs/ecodisc-side1/framemaps/ (made by the
# map stage), and processes it. Nothing here is refreshed, so the stack is
# built from the reviewed maps.
#
# Each source is labelled with its set id and its frame map "<set> map", as
# in map.orcprj. The sources must be the video sets of selection.yaml, in
# the same order: the first sets the Stacker's sample grid (the compare
# report's suggested reference). Adding or dropping a set means editing this
# project.
#
# The Stacker stacks repeats (still_frame_stacking): a picture held over
# several frames is stacked across them as well as across the sets, which is
# most of what stacking gains on held pictures. still_frame_search,
# luma_level_match and chroma_gain_match are left to decode-orc's defaults
# (24 frames, on, on). The video sink decodes held pictures in 3D and every
# other frame in 2D (decoder_type multiple, decoder_schedule
# "transform2d, held:transform3d"): 3D is better only where the picture is
# held, and worse on single-frame stills. build-pack.sh sets the decoder from
# disc.conf, so the two are the same.

project:
  name: EcoDisc Side 1 stack
  version: 2.0
  video_format: PAL
  source_format: Composite
  amplitude_unit: 10bit
dag:
  nodes:
    - id: 1
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS5
      x: 50
      y: 50
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 2
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS3
      x: 50
      y: 175
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 3
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS4
      x: 50
      y: 300
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 4
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS1
      x: 50
      y: 425
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 5
      stage: PAL_CVBS_Source
      node_type: SOURCE
      display_name: CVBS Source
      user_label: DS2
      x: 50
      y: 550
      parameters:
        c_path:
          type: string
          value: ""
        input_path:
          type: string
          value: ""
        sample_encoding:
          type: string
          value: From metadata
        y_path:
          type: string
          value: ""
    - id: 6
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS5 map
      x: 275
      y: 50
      parameters:
        ranges:
          type: string
          value: ""
    - id: 7
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS3 map
      x: 275
      y: 175
      parameters:
        ranges:
          type: string
          value: ""
    - id: 8
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS4 map
      x: 275
      y: 300
      parameters:
        ranges:
          type: string
          value: ""
    - id: 9
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS1 map
      x: 275
      y: 425
      parameters:
        ranges:
          type: string
          value: ""
    - id: 10
      stage: frame_map
      node_type: TRANSFORM
      display_name: Frame Map
      user_label: DS2 map
      x: 275
      y: 550
      parameters:
        ranges:
          type: string
          value: ""
    - id: 11
      stage: source_align
      node_type: COMPLEX
      display_name: Source Align
      user_label: Align
      x: 500
      y: 50
      parameters:
        alignmentMap:
          type: string
          value: ""
        alignmentMode:
          type: string
          value: pad_for_alignment
    - id: 12
      stage: stacker
      node_type: MERGER
      display_name: Stacker
      user_label: Stack
      x: 725
      y: 50
      parameters:
        mode:
          type: string
          value: Weighted
        reject_sigma:
          type: double
          value: 5
        no_diff_dod:
          type: bool
          value: false
        passthrough:
          type: bool
          value: false
        sample_align:
          type: bool
          value: true
        audio_stacking:
          type: string
          value: Mean
        efm_stacking:
          type: string
          value: Disabled
        still_frame_stacking:
          type: bool
          value: true
    - id: 13
      stage: dropout_correct
      node_type: TRANSFORM
      display_name: Dropout Correction
      user_label: DOC
      x: 950
      y: 50
      parameters:
        overcorrect_extension:
          type: uint32
          value: 0
        match_chroma_phase:
          type: bool
          value: true
        highlight_corrections:
          type: bool
          value: false
    - id: 14
      stage: video_sink
      node_type: SINK
      display_name: Video Sink
      user_label: Video Out
      x: 1175
      y: 50
      parameters:
        output_path:
          type: string
          value: ""
        output_mode:
          type: string
          value: ffmpeg
        ffmpeg_format:
          type: string
          value: mkv-ffv1-bt601
        bt601_bit_depth:
          type: string
          value: 8
        ffv1_slices:
          type: string
          value: auto
        decoder_type:
          type: string
          value: multiple
        decoder_schedule:
          type: string
          value: transform2d, held:transform3d
        display_aspect_ratio:
          type: string
          value: 4:3
        noise_reduction:
          type: double
          value: 0
        chroma_gain:
          type: double
          value: 1
        chroma_phase:
          type: double
          value: 0
        embed_audio:
          type: bool
          value: true
        audio_channel_pairs:
          type: string
          value: all
        audio_gain_db:
          type: double
          value: 0
        embed_chapter_metadata:
          type: bool
          value: true
        embed_disc_metadata:
          type: bool
          value: true
        disc_metadata_detail:
          type: string
          value: map
        video_filter:
          type: string
          value: ""
  edges:
    - from: 1
      to: 6
    - from: 2
      to: 7
    - from: 3
      to: 8
    - from: 4
      to: 9
    - from: 5
      to: 10
    - from: 6
      to: 11
    - from: 7
      to: 11
    - from: 8
      to: 11
    - from: 9
      to: 11
    - from: 10
      to: 11
    - from: 11
      to: 12
    - from: 12
      to: 13
    - from: 13
      to: 14
